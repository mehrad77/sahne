{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sahne-gallery",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd packages/sahne-gallery && PORT=${PORT:-5180} node serve.mjs"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "sahne-backstage",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd packages/sahne-backstage && node server/cli.ts --port ${PORT:-5181}"
      ],
      "port": 5181,
      "autoPort": true
    }
  ]
}
