{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.json",
  "title": "A story document (STORIES_SCHEMA.md §3-§4)",
  "type": "object",
  "required": [
    "id",
    "releaseDate",
    "kind",
    "level",
    "season",
    "arc",
    "ref",
    "title",
    "summary",
    "place",
    "cast",
    "lessons",
    "words",
    "gl",
    "steps",
    "quiz"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s[1-9][0-9]?e[0-9]{2}$"
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "kind": {
      "enum": [
        "episode",
        "special"
      ]
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1"
      ]
    },
    "season": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "arc": {
      "type": "object",
      "required": [
        "id",
        "mechanics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[1-9][0-9]?w[0-9]{2}$"
        },
        "mechanics": {
          "type": "array",
          "items": {
            "enum": [
              "say",
              "explore",
              "act",
              "aloud",
              "unlocks"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^(A1|A2|B1)_[1-6]$"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "place": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "cast": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^g_(a1|a2|b1)_[0-9]+_[a-z0-9_]+$"
      }
    },
    "words": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gl": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^A-ZİÇĞÖŞÜ]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kit",
          "at"
        ],
        "properties": {
          "kit": {
            "type": "string"
          }
        }
      }
    },
    "looks": {
      "$ref": "#/$defs/looks"
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "followUp": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "q",
          "options",
          "a",
          "why",
          "kind"
        ],
        "properties": {
          "q": {
            "$ref": "#/$defs/text"
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "a": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "comp",
              "word"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "draft": {
      "const": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "looks": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "line": {
      "type": "object",
      "required": [
        "who"
      ],
      "properties": {
        "who": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "narr": {
          "const": true
        },
        "cam": {
          "enum": [
            "wide",
            "two",
            "single",
            "close",
            "ots",
            "obj",
            "follow",
            "split",
            "photo"
          ]
        },
        "voice": {
          "enum": [
            "normal",
            "whisper",
            "silent",
            "mouthing"
          ]
        },
        "via": {
          "enum": [
            "phone",
            "video"
          ]
        },
        "frame": {
          "enum": [
            "past",
            "past_inset"
          ]
        },
        "mistake": {
          "type": "object",
          "required": [
            "fix"
          ],
          "properties": {
            "fix": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "note": {
          "type": "object"
        },
        "looks": {
          "$ref": "#/$defs/looks"
        },
        "if": {
          "type": "string"
        },
        "unless": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "required": [],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "tone": {
          "enum": [
            "polite",
            "warm",
            "formal",
            "casual",
            "blunt",
            "rude"
          ]
        },
        "sets": {
          "type": "string",
          "pattern": "^s[1-9][0-9]?e[0-9]{2}_[a-z0-9_]+$"
        },
        "warm": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              -1,
              0,
              1
            ]
          }
        },
        "reply": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "who"
          ],
          "$ref": "#/$defs/line"
        },
        {
          "required": [
            "beat"
          ],
          "properties": {
            "beat": {
              "type": "object"
            },
            "if": {
              "type": "string"
            },
            "unless": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "scene"
          ],
          "properties": {
            "scene": {
              "type": "string"
            },
            "time": {
              "enum": [
                "dawn",
                "day",
                "golden",
                "dusk",
                "night",
                "overcast"
              ]
            },
            "weather": {
              "enum": [
                "grey",
                "rain"
              ]
            },
            "state": {
              "type": [
                "string",
                "array"
              ]
            },
            "at": {
              "type": "object"
            },
            "kerim": {
              "type": "string"
            },
            "stop": {
              "type": "string"
            },
            "looks": {
              "$ref": "#/$defs/looks"
            },
            "if": {
              "type": "string"
            },
            "unless": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "spot"
          ],
          "properties": {
            "spot": {
              "type": "object",
              "required": [
                "lesson",
                "ex"
              ],
              "properties": {
                "lesson": {
                  "type": "string"
                },
                "ex": {
                  "type": "string",
                  "minLength": 1
                },
                "show": {
                  "enum": [
                    "deixis",
                    "var_yok",
                    "case_path",
                    "owner",
                    "compare",
                    "aspect",
                    "clock"
                  ]
                }
              }
            },
            "if": {
              "type": "string"
            },
            "unless": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "choice"
          ],
          "properties": {
            "choice": {
              "type": "object",
              "required": [
                "id",
                "options"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "kind": {
                  "enum": [
                    "polite",
                    "meaning",
                    "action"
                  ]
                },
                "to": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": {
                    "$ref": "#/$defs/option"
                  }
                }
              }
            },
            "if": {
              "type": "string"
            },
            "unless": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "act"
          ],
          "properties": {
            "act": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "targets"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "tap",
                    "drag",
                    "go",
                    "choose"
                  ]
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "if": {
              "type": "string"
            },
            "unless": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
