{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sahne-story/season.json",
  "title": "A season of the series (seasons/s<n>.json): its titles, its weeks' arcs and its release calendar",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "n", "title"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^s[1-9][0-9]?$" },
    "n": { "type": "integer", "minimum": 1, "maximum": 99 },
    "title": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }, "additionalProperties": { "type": "string", "minLength": 1 } },
    "summary": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }, "additionalProperties": { "type": "string", "minLength": 1 } },
    "launch": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "arcs": {
      "type": "object",
      "propertyNames": { "pattern": "^s[1-9][0-9]?w[0-9]{2}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanics"],
        "patternProperties": { "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": { "type": "string", "minLength": 1 } },
        "properties": {
          "mechanics": { "type": "array", "uniqueItems": true, "items": { "enum": ["say", "explore", "act", "aloud", "unlocks"] } }
        }
      }
    },
    "calendar": {
      "type": "object",
      "propertyNames": { "pattern": "^s[1-9][0-9]?e[0-9]{2}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "kind", "week"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "kind": { "enum": ["episode", "special"] },
          "week": { "type": "integer", "minimum": 0, "maximum": 99 }
        }
      }
    }
  }
}
