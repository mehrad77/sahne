{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sahne-story/kit-piece.json",
  "title": "A set piece or prop drawn as data (kit/pieces/<id>.json): sahne-kit/DRAWING.md describes the format",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "as", "about", "kinds"],
  "properties": {
    "id": { "type": "string", "pattern": "^x_[a-z0-9_]+$", "maxLength": 48 },
    "as": { "enum": ["prop", "set", "both"] },
    "about": { "type": "string", "minLength": 9, "maxLength": 200 },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "terms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "params": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]*$", "not": { "enum": ["n", "held", "variant"] } },
      "additionalProperties": { "$ref": "#/$defs/param" }
    },
    "kinds": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }, "additionalProperties": { "$ref": "#/$defs/kind" } },
    "repeat": { "type": "object", "additionalProperties": false, "properties": { "gap": { "type": "number", "minimum": 0, "maximum": 200 } } },
    "variants": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }, "additionalProperties": { "type": "object" } },
    "solid": {
      "type": ["array", "null"],
      "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["a", "b"],
        "properties": { "a": { "$ref": "#/$defs/pt" }, "b": { "$ref": "#/$defs/pt" }, "door": { "const": true } }
      }
    }
  },
  "$defs": {
    "pt": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "colour": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|\\$[A-Za-z_][A-Za-z0-9_]*|[a-z]+_[0-9]{2})$" },
    "fill": {
      "oneOf": [
        { "$ref": "#/$defs/colour" },
        {
          "type": "object", "additionalProperties": false, "required": ["tone", "step"],
          "properties": { "tone": { "$ref": "#/$defs/colour" }, "step": { "enum": ["base", "shade", "deep", "light", "edge"] } }
        }
      ]
    },
    "param": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["enum", "int", "num", "bool", "text", "color"] },
        "default": {},
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "about": { "type": "string" }
      }
    },
    "shape": {
      "type": "object", "additionalProperties": false, "required": ["d"],
      "properties": {
        "d": { "type": "string", "minLength": 4, "maxLength": 8000 },
        "fill": { "$ref": "#/$defs/fill" },
        "stroke": {
          "type": "object", "additionalProperties": false, "required": ["color", "width"],
          "properties": { "color": { "$ref": "#/$defs/fill" }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }, "cap": { "enum": ["butt", "round", "square"] } }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "flat": { "type": "boolean" },
        "evenodd": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["fill"] }, { "required": ["stroke"] }]
    },
    "text": {
      "type": "object", "additionalProperties": false, "required": ["text", "x", "y", "w", "h", "lang"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 },
        "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "font": { "enum": ["hand", "print", "screen"] },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "$ref": "#/$defs/fill" },
        "align": { "enum": ["left", "center", "right"] },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "lit": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "flat": {
      "type": "object", "additionalProperties": false, "required": ["shapes"],
      "properties": {
        "shapes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shape" } },
        "text": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "glow": { "type": "array", "items": { "$ref": "#/$defs/shape" } },
        "sway": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["ms"],
          "properties": { "rot": { "type": "number" }, "dy": { "type": "number" }, "ms": { "type": "number", "minimum": 200 } }
        },
        "blink": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["ms", "on"],
          "properties": { "ms": { "type": "number", "minimum": 200 }, "on": { "type": "number", "minimum": 0, "maximum": 1 }, "at": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        "shadow": { "enum": ["drop", "none"] },
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
        "lit": { "type": "number", "minimum": 0, "maximum": 1 },
        "front": { "type": "boolean" }
      }
    },
    "kind": {
      "type": "object", "additionalProperties": false, "required": ["size", "flats"],
      "properties": {
        "size": { "type": "array", "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "minItems": 2, "maxItems": 2 },
        "ppcm": { "type": "number", "exclusiveMinimum": 0, "maximum": 16 },
        "grip": { "$ref": "#/$defs/pt" },
        "flats": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/flat" } },
        "lights": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "color", "radius"],
            "properties": {
              "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "color": { "$ref": "#/$defs/hex" },
              "radius": { "type": "number", "exclusiveMinimum": 0 }, "intensity": { "type": "number" }, "at": { "type": "array", "items": { "type": "string" } }, "switch": { "const": false }
            }
          }
        },
        "emitters": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "x", "y"],
            "properties": { "kind": { "enum": ["steam", "smoke", "flame"] }, "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "w": { "type": "number" } }
          }
        }
      }
    }
  }
}
